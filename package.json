{
  "name": "Quest",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && npm --prefix spacetimedb run typecheck",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview",
    "generate": "npm run spacetime:generate",
    "spacetime:build": "spacetime build --module-path spacetimedb",
    "spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "spacetime:publish:local": "spacetime publish --module-path spacetimedb --server local",
    "spacetime:publish": "spacetime publish --module-path spacetimedb --server maincloud"
  },
  "dependencies": {
    "oidc-client-ts": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-oidc-context": "^3.3.1",
    "spacetimedb": "2.14.*"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.6.2",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
