# Copy to .env.local for development. Set these public values as Railway service variables before building.
# Vite bakes VITE_ values into dist; rebuild after changing them.
# Browser-visible settings only. Never put secrets in VITE_ variables.
VITE_SPACETIMEDB_DB_NAME=quest-db
VITE_SPACETIMEDB_HOST=https://maincloud.spacetimedb.com

# Public SpacetimeAuth client ID (not Google OAuth client ID or a client secret).
VITE_SPACETIMEAUTH_CLIENT_ID=client_034th99S8ZfAMgWt5nNYdF

# Public vector-map style and fallback center (Dallas / UTD).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
VITE_MAP_DEFAULT_LATITUDE=32.9858
VITE_MAP_DEFAULT_LONGITUDE=-96.7501

# Login callback is automatically <current-origin>/callback; logout returns to <current-origin>/.
# Register both exact production URLs in SpacetimeAuth. No frontend client secret is needed.
# Runtime: Railway supplies PORT (Caddy defaults to 8080 locally).
